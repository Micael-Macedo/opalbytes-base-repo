{
  "name": "opalbytes-base-repo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint --fix && stylelint \"src/**/*.scss\" --fix",
    "lint:fix": "ng lint --fix",
    "lint:styles": "stylelint \"src/**/*.scss\" --fix",
    "start:prod": "ng serve --open --configuration production",
    "start:hmg": "ng serve --open --configuration homologation",
    "start:dev": "ng serve --open --configuration development",
    "start:local": "ng serve --open --configuration local",
    "build:prod": "ng build --configuration production",
    "build:hmg": "ng build --configuration homologation",
    "build:dev": "ng build --configuration development",
    "build:local": "ng build --configuration local",
    "watch": "ng build --watch --configuration development",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "~21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@lucide/angular": "1.72.0",
    "ngx-opalbytes-components": "^1.28.0",
    "ngx-opalbytes-core": "^1.4.0",
    "ngx-webstorage": "21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "husky": "9.1.7",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
