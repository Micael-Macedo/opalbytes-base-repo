{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "opalbytes-base-repo": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "optimization": false,
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "define": {
                "APP_ENV": "'prod'",
                "APP_VERSION": "'dev'",
                "APP_BUILD_DATE": "'dev'"
              }
            },
            "homologation": {
              "optimization": false,
              "extractLicenses": true,
              "sourceMap": true,
              "namedChunks": true,
              "define": {
                  "APP_ENV": "'hmg'",
                  "APP_VERSION": "'dev'",
                  "APP_BUILD_DATE": "'dev'"
              }
            },
            "development": {
              "namedChunks": true,
              "optimization": false,
              "extractLicenses": true,
              "sourceMap": true,
              "define": {
                  "APP_ENV": "'dev'",
                  "APP_VERSION": "'dev'",
                  "APP_BUILD_DATE": "'dev'"
              }
            },
            "local": {
              "namedChunks": true,
              "optimization": false,
              "extractLicenses": true,
              "sourceMap": true,
              "outputHashing": "all",
              "define": {
                  "APP_ENV": "'local'",
                  "APP_VERSION": "'dev'",
                  "APP_BUILD_DATE": "'dev'"
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "opalbytes-base-repo:build:production"
            },
            "homologation": {
                "buildTarget": "opalbytes-base-repo:build:homologation"
            },
            "development": {
                "buildTarget": "opalbytes-base-repo:build:development"
            },
            "local": {
                "buildTarget": "opalbytes-base-repo:build:local"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
